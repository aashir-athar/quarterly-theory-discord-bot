# Required: Discord channel > Edit Channel > Integrations > Webhooks > New Webhook > Copy URL
DISCORD_WEBHOOK_URL=

# Optional
BOT_NAME=Quarterly Theory
BOT_AVATAR_URL=
# Role ID to ping on every phase shift (leave empty for no ping)
MENTION_ROLE_ID=
# Any of: yearly,monthly,weekly,daily,micro
TIMEFRAMES=yearly,monthly,weekly,daily,micro
# Also show the original UTC window under the PKT times
SHOW_UTC=false
# Post the live board once when the bot starts
SNAPSHOT_ON_START=true
# If the PC was asleep and woke later than this many seconds after a boundary, skip the stale alert
MAX_LATE_SECONDS=600
